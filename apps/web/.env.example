# Everything is optional for local development: without DATABASE_URL an embedded Postgres (PGlite) is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# DATABASE_URL=postgres://...            # Neon in production
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=                    # openssl rand -hex 32 (required in production)
# API_KEY_PEPPER=                        # openssl rand -hex 24 (required in production; never change it later)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=                        # optional, for email sign-in links
# EMAIL_FROM="AugLeak <signin@yourdomain>"
# AUTO_MIGRATE=1                         # create tables on first start (production)
